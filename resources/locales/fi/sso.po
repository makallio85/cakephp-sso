# Finnish translations for makallio85/cakephp-sso.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: fi\n"

msgid "Client ID"
msgstr "Asiakastunnus (Client ID)"

msgid "Client secret"
msgstr "Asiakassalaisuus (Client secret)"

msgid "Connected."
msgstr "Yhteys toimii."

msgid "Emergency sign-in"
msgstr "Hätäkirjautuminen"

msgid "Enter the client ID."
msgstr "Anna asiakastunnus."

msgid "Enter the client secret: none is stored yet."
msgstr "Anna asiakassalaisuus: sitä ei ole vielä tallennettu."

msgid "Identity provider"
msgstr "Tunnistuspalvelu"

msgid "Identity server address"
msgstr "Tunnistuspalvelun osoite"

msgid "Last changed by {0}, {1}."
msgstr "Viimeksi muuttanut {0}, {1}."

msgid "Connected by Rock Software ID, {0}."
msgstr "Yhdistetty Rock Software ID:stä, {0}."

msgid "Not configured yet. Enter the connection below; it is saved once the server answers."
msgstr "Ei vielä määritetty. Anna yhteystiedot alla; ne tallennetaan, kun palvelin vastaa."

msgid "Not saved. {0} The previous settings are still in use."
msgstr "Ei tallennettu. {0} Aiemmat asetukset ovat yhä käytössä."

msgid "People sign in through Rock Software ID. These settings say which server and which client."
msgstr "Kirjautuminen tapahtuu Rock Software ID:llä. Nämä asetukset kertovat, mikä palvelin ja mikä asiakas."

msgid "Redirect URI to register at the provider"
msgstr "Paluuosoite, joka rekisteröidään tunnistuspalveluun"

msgid "Required"
msgstr "Pakollinen"

msgid "Required group"
msgstr "Pääsyn antava ryhmä"

msgid "Save"
msgstr "Tallenna"

msgid "Save checks the server first. Settings that cannot reach it are not saved, so nobody is locked out."
msgstr "Tallennus tarkistaa ensin palvelimen. Asetuksia, joilla palvelinta ei tavoiteta, ei tallenneta, joten kukaan ei jää ulos."

msgid "Saved. Sign-in now uses this identity server."
msgstr "Tallennettu. Kirjautuminen käyttää nyt tätä tunnistuspalvelua."

msgid "Sign in"
msgstr "Kirjaudu"

msgid "Sign in with Rock Software ID"
msgstr "Kirjaudu Rock Software ID:llä"

msgid "Sign-in is not configured yet. Connect this deployment to Rock Software ID with {0} in the application container."
msgstr "Kirjautumista ei ole vielä määritetty. Yhdistä tämä asennus Rock Software ID:hen komennolla {0} sovelluksen kontissa."

msgid "Sign-in through Rock Software ID failed. Try again, or contact the administrator."
msgstr "Kirjautuminen Rock Software ID:llä epäonnistui. Yritä uudelleen tai ota yhteyttä pääkäyttäjään."

msgid "Sign-in through Rock Software ID is not available."
msgstr "Kirjautuminen Rock Software ID:llä ei ole käytettävissä."

msgid "Stored encrypted and never shown. In Authentik: Applications › Providers › the provider › Edit."
msgstr "Tallennetaan salattuna eikä näytetä koskaan. Authentikissa: Applications › Providers › palveluntarjoaja › Edit."

msgid "Stored — leave blank to keep it"
msgstr "Tallennettu — jätä tyhjäksi, niin se säilyy"

msgid "Test connection"
msgstr "Testaa yhteys"

msgid "The identity server address must be an https URL."
msgstr "Tunnistuspalvelun osoitteen pitää olla https-osoite."

msgid "The identity server answered. Nothing was saved."
msgstr "Tunnistuspalvelu vastasi. Mitään ei tallennettu."

msgid "The identity server could not be asked: {0}"
msgstr "Tunnistuspalvelulta ei voitu kysyä: {0}"

msgid "The identity server did not answer: {0}"
msgstr "Tunnistuspalvelu ei vastannut: {0}"

msgid "The issuer URL: https://id.rocksoftware.fi/application/o/ followed by the application's slug."
msgstr "Issuer-osoite: https://id.rocksoftware.fi/application/o/ ja perään sovelluksen tunnus (slug)."

msgid "The server answers its discovery document."
msgstr "Palvelin vastaa discovery-kyselyyn."

msgid "The stored server does not answer."
msgstr "Tallennettu palvelin ei vastaa."

msgid "This address did not answer as an identity server. Check that the path ends in the application's slug."
msgstr "Osoite ei vastannut tunnistuspalveluna. Tarkista, että polku päättyy sovelluksen tunnukseen."

msgid "This link signs you in once, without Rock Software ID. Use it only when Rock Software ID is unavailable."
msgstr "Tällä linkillä kirjaudut kerran ilman Rock Software ID:tä. Käytä sitä vain, kun Rock Software ID ei ole käytettävissä."

msgid "This sign-in link is invalid, expired or already used."
msgstr "Kirjautumislinkki on virheellinen, vanhentunut tai jo käytetty."

msgid "You may not change the identity provider settings."
msgstr "Sinulla ei ole oikeutta muuttaa tunnistuspalvelun asetuksia."

msgid "Your account has no access to this application."
msgstr "Tunnuksellasi ei ole pääsyä tähän sovellukseen."

msgid "Your session has ended. Please sign in again."
msgstr "Istuntosi on päättynyt. Kirjaudu uudelleen."

msgid "a removed user"
msgstr "poistettu käyttäjä"

msgid "Rock Software ID may connect this application during the next hour."
msgstr "Rock Software ID voi yhdistää tämän sovelluksen seuraavan tunnin aikana."

msgid "Connection by Rock Software ID"
msgstr "Yhdistäminen Rock Software ID:stä"

msgid "Waiting. Rock Software ID connects this application when its administrator runs new-id-app.sh; nothing needs to be typed here."
msgstr "Odottaa. Rock Software ID yhdistää tämän sovelluksen, kun sen ylläpitäjä ajaa new-id-app.sh:n; tähän ei tarvitse kirjoittaa mitään."

msgid "Open until {0}. Run new-id-app.sh now; the connection it sends closes this again."
msgstr "Avoinna klo {0} asti. Aja new-id-app.sh nyt; sen lähettämä yhteys sulkee tämän taas."

msgid "Closed. Rock Software ID cannot change this connection. Open it for an hour to set a new client secret or client; the next connection closes it again."
msgstr "Suljettu. Rock Software ID ei voi muuttaa tätä yhteyttä. Avaa se tunniksi, kun asiakassalaisuus tai asiakas vaihdetaan; seuraava yhdistäminen sulkee sen taas."

msgid "Allow Rock Software ID to connect again"
msgstr "Salli Rock Software ID:n yhdistää uudelleen"

msgid "Password sign-in"
msgstr "Kirjautuminen salasanalla"

msgid "Off. Only Rock Software ID signs people in. Turning it back on lets everyone use their password again at once."
msgstr "Pois päältä. Vain Rock Software ID kirjaa ihmiset sisään. Kun sen kytkee takaisin päälle, kaikki voivat heti taas käyttää salasanaansa."

msgid "On. People can also sign in with their email address and password on the sign-in page. Turn it off once everyone has signed in through Rock Software ID once."
msgstr "Päällä. Kirjautumissivulla voi kirjautua myös sähköpostilla ja salasanalla. Kytke se pois, kun jokainen on kirjautunut kerran Rock Software ID:llä."

msgid "On. To turn it off, sign in through Rock Software ID first, so nobody can lock themselves out."
msgstr "Päällä. Kirjaudu ensin Rock Software ID:llä, jotta voit kytkeä sen pois – näin kukaan ei lukitse itseään ulos."

msgid "Turn password sign-in off"
msgstr "Kytke salasanakirjautuminen pois"

msgid "Turn password sign-in on"
msgstr "Kytke salasanakirjautuminen päälle"

msgid "Password sign-in turned on by {0}, {1}."
msgstr "Salasanakirjautumisen kytki päälle {0}, {1}."

msgid "Password sign-in turned off by {0}, {1}."
msgstr "Salasanakirjautumisen kytki pois {0}, {1}."

msgid "Password sign-in stays on. Sign in through Rock Software ID first, so nobody can lock themselves out."
msgstr "Salasanakirjautuminen jää päälle. Kirjaudu ensin Rock Software ID:llä, jotta kukaan ei lukitse itseään ulos."

msgid "Password sign-in stays on: the identity server does not answer. {0}"
msgstr "Salasanakirjautuminen jää päälle: tunnistuspalvelin ei vastaa. {0}"

msgid "Password sign-in is on. People can sign in with their password again."
msgstr "Salasanakirjautuminen on päällä. Ihmiset voivat taas kirjautua salasanallaan."

msgid "Password sign-in is off. Only Rock Software ID signs people in."
msgstr "Salasanakirjautuminen on pois päältä. Vain Rock Software ID kirjaa ihmiset sisään."

msgid "Password sign-in has been turned off. Please sign in with Rock Software ID."
msgstr "Salasanakirjautuminen on kytketty pois. Kirjaudu Rock Software ID:llä."

msgid "Not available. This application has no passwords of its own; people sign in only through Rock Software ID."
msgstr "Ei käytettävissä. Sovelluksella ei ole omia salasanoja; kirjautuminen tapahtuu vain Rock Software ID:llä."

msgid "Your session has expired. Please sign in again."
msgstr "Istuntosi on vanhentunut. Kirjaudu uudelleen."

msgid "Password sign-in is off. Sign in with Rock Software ID."
msgstr "Salasanakirjautuminen on pois päältä. Kirjaudu Rock Software ID:llä."

msgid "Your account has been deactivated in this application."
msgstr "Käyttäjätunnuksesi on suljettu tässä sovelluksessa."

msgid "The email address or password is wrong."
msgstr "Sähköpostiosoite tai salasana on väärin."

msgid "Too many failed sign-ins. Try again in {0} minutes, or sign in with Rock Software ID."
msgstr "Liian monta epäonnistunutta kirjautumista. Yritä uudelleen {0} minuutin kuluttua, tai kirjaudu Rock Software ID:llä."

msgid "You may not manage users."
msgstr "Sinulla ei ole oikeutta hallita käyttäjiä."

msgid "{0} is signed out of this application."
msgstr "{0} on kirjattu ulos tästä sovelluksesta."

msgid "You cannot deactivate yourself."
msgstr "Et voi sulkea omaa tunnustasi."

msgid "{0} can sign in again."
msgstr "{0} voi taas kirjautua."

msgid "{0} is deactivated and signed out of this application."
msgstr "{0} on suljettu ja kirjattu ulos tästä sovelluksesta."

msgid "Session settings saved."
msgstr "Istuntoasetukset tallennettu."

